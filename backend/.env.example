# JWT Configuration
JWT_SECRET=your-secure-jwt-secret-key-here

# Server Configuration
PORT=3000

# Database Configuration
# Local development default: SQLite. Production options: postgres, mysql, mariadb.
DATABASE_TYPE=sqlite
DATABASE_PATH=./database.sqlite

# URL takes precedence over host/port fields.
# Examples:
# DATABASE_URL=postgresql://user:password@host:5432/skill_platform
# DATABASE_URL=mysql://user:password@host:3306/skill_platform
DATABASE_URL=

# Host/port style config for PostgreSQL/MySQL/MariaDB when DATABASE_URL is empty.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=skill_platform
DATABASE_PASSWORD=
DATABASE_NAME=skill_platform
DATABASE_SSL=false
DATABASE_POOL_SIZE=30
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CHARSET=utf8mb4
TYPEORM_SYNCHRONIZE=true

# Environment
NODE_ENV=development

# Qwen API (通义千问)
QWEN_API_KEY=your-qwen-api-key
LLM_DEFAULT_CHAT_MODEL=qwen-plus

# Training / capacity safeguards
# Cache dashboard aggregate stats to avoid every trainee recomputing counts on entry.
DASHBOARD_STATS_CACHE_TTL_MS=60000
AGENTS_LIST_CACHE_TTL_MS=60000
SKILLS_LIST_CACHE_TTL_MS=60000
KNOWLEDGE_LIST_CACHE_TTL_MS=60000

# Existing-user login audit is written asynchronously so classroom login spikes are not blocked by audit writes.
AUTH_LOGIN_AUDIT_DELAY_MS=10000

# Cap concurrent AI chat runs and queue the rest with user-visible status updates.
CHAT_RUN_CONCURRENCY_LIMIT=80
CHAT_RUN_QUEUE_LIMIT=500
CHAT_RUN_QUEUE_TIMEOUT_MS=90000

# Alibaba Cloud AgentRun Sandbox
# Keep disabled until the sandbox product and templates are ready.
AGENTRUN_SANDBOX_ENABLED=false
AGENTRUN_ACCOUNT_ID=
AGENTRUN_REGION=cn-hangzhou
AGENTRUN_ACCESS_KEY_ID=
AGENTRUN_ACCESS_KEY_SECRET=
AGENTRUN_SECURITY_TOKEN=
AGENTRUN_CODE_TEMPLATE_NAME=
AGENTRUN_BROWSER_TEMPLATE_NAME=
AGENTRUN_SANDBOX_IDLE_TIMEOUT_SECONDS=900
AGENTRUN_SANDBOX_MAX_EXECUTION_SECONDS=60
ALLOW_LOCAL_CODE_EXECUTION_FALLBACK=false
